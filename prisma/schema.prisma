// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                     @id @default(cuid())
  username             String                     @unique
  password             String
  role                 String                     @default("USER") // USER or ADMIN
  contributedAmount    Float                      @default(0)
  totalPoints          Int                        @default(0)
  previousPosition     Int?                       // Para las flechas de tendencia en la tabla
  predictions          Prediction[]
  qualifierPredictions GroupQualifierPrediction[] // Relación con el nuevo modelo
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
}

model TournamentStage {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(false)
  matches   Match[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id         String   @id @default(cuid())
  name       String   @unique
  flagUrl    String?
  matchesAsA Match[]  @relation("TeamA")
  matchesAsB Match[]  @relation("TeamB")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Match {
  id          String       @id @default(cuid())
  stageId     String
  stage       TournamentStage @relation(fields: [stageId], references: [id])
  teamAId     String
  teamA       Team         @relation("TeamA", fields: [teamAId], references: [id])
  teamBId     String
  teamB       Team         @relation("TeamB", fields: [teamBId], references: [id])
  teamAScore  Int?
  teamBScore  Int?
  isFinished  Boolean      @default(false)
  date        DateTime?
  predictions Prediction[]
  penaltyWinner String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Prediction {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id])
  teamAScore   Int
  teamBScore   Int
  pointsEarned Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  penaltyWinner String?

  @@unique([userId, matchId])
}

model Settings {
  id               String   @id @default(cuid())
  exactMatchPoints Int      @default(3)
  tendencyPoints   Int      @default(1)
  drawPoints       Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// NUEVO MODELO: Predicciones de Clasificados de Fase de Grupos
model GroupQualifierPrediction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  teamName  String
  groupName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Evita que un usuario duplique el mismo equipo
  @@unique([userId, teamName])
}